{
  "name": "Nova ACT Extension",
  "description": "Nova ACT Extension v1.0.0",
  "version": "1.0.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "static/background/index.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.plasmo.ef6030e0.png",
      "32": "icon32.plasmo.598c4db3.png",
      "48": "icon48.plasmo.0ee1303b.png",
      "64": "icon64.plasmo.8d03a7fe.png",
      "128": "icon128.plasmo.1b077857.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.d585fe88.js"]
    }
  ]
}